<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>TerraVision | Harmonized Burning Activity Calendar & Fire Intelligence</title>
    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Chart.js CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <!-- FontAwesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <style>
        #map { height: 600px; width: 100%; }
        .heatmap-cell { transition: all 0.2s; }
        .heatmap-cell:hover { transform: scale(1.05); border: 2px solid #000; }
    </style>
</head>
<body class="bg-slate-900 text-slate-100 font-sans antialiased">
    <!-- Header -->
    <header class="bg-slate-800 border-b border-slate-700 sticky top-0 z-50">
        <div class="max-w-7xl mx-auto px-4 py-4 flex flex-col md:flex-row justify-between items-center">
            <div class="flex items-center space-x-3 mb-3 md:mb-0">
                <div class="bg-orange-600 p-2 rounded-lg text-white">
                    <i class="fa-solid fa-fire-flame-curved text-2xl"></i>
                </div>
                <div>
                    <h1 class="text-xl font-bold tracking-tight text-white">TerraVision</h1>
                    <p class="text-xs text-slate-400">Harmonized MODIS & VIIRS Fire Hotspots & Burning Activity Calendar</p>
                </div>
            </div>
            <div class="flex items-center space-x-4">
                <span class="inline-flex items-center px-3 py-1 rounded-full text-xs font-medium bg-emerald-900 text-emerald-300 border border-emerald-700">
                    <span class="w-2 h-2 mr-1.5 bg-emerald-400 rounded-full animate-pulse"></span> Harmonization Active (MODIS + VIIRS)
                </span>
                <a href="/api/proxy/export?sensor=<%= filters.sensor %>&start_date=<%= filters.start_date %>&end_date=<%= filters.end_date %>" 
                   class="inline-flex items-center px-3 py-2 bg-orange-600 hover:bg-orange-500 text-white text-sm font-medium rounded-lg transition shadow">
                    <i class="fa-solid fa-download mr-2"></i> Export CSV
                </a>
            </div>
        </div>
    </header>

    <% if (locals.error) { %>
    <div class="max-w-7xl mx-auto px-4 mt-4">
        <div class="bg-red-900/50 border border-red-700 text-red-200 px-4 py-3 rounded-lg flex items-center justify-between">
            <span><i class="fa-solid fa-triangle-exclamation mr-2"></i> <%= error %></span>
            <span class="text-xs">Ensure Flask backend runs on port 5000 (`python backend/app.py`).</span>
        </div>
    </div>
    <% } %>

    <!-- Main Container -->
    <main class="max-w-7xl mx-auto px-4 py-6 space-y-6">
        
        <!-- Filter Bar -->
        <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg">
            <form action="/" method="GET" class="grid grid-cols-1 md:grid-cols-4 gap-4 items-end">
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Satellite Sensor</label>
                    <select name="sensor" class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500">
                        <option value="all" <%= filters.sensor === 'all' ? 'selected' : '' %>>All (Harmonized MODIS + VIIRS)</option>
                        <option value="MODIS" <%= filters.sensor === 'MODIS' ? 'selected' : '' %>>MODIS (Terra/Aqua - Historical)</option>
                        <option value="VIIRS" <%= filters.sensor === 'VIIRS' ? 'selected' : '' %>>VIIRS (375m - High Detail)</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">Start Date</label>
                    <input type="date" name="start_date" value="<%= filters.start_date %>" 
                           class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500">
                </div>
                <div>
                    <label class="block text-xs font-medium text-slate-400 mb-1">End Date</label>
                    <input type="date" name="end_date" value="<%= filters.end_date %>" 
                           class="w-full bg-slate-900 border border-slate-700 rounded-lg px-3 py-2 text-sm text-white focus:outline-none focus:border-orange-500">
                </div>
                <div>
                    <button type="submit" class="w-full bg-orange-600 hover:bg-orange-500 text-white font-medium py-2 px-4 rounded-lg text-sm transition shadow flex items-center justify-center">
                        <i class="fa-solid fa-filter mr-2"></i> Apply Filters
                    </button>
                </div>
            </form>
        </div>

        <!-- Metrics Overview Grid -->
        <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">Total Hotspots Detected</p>
                    <h3 class="text-2xl font-bold text-white mt-1"><%= totalCount.toLocaleString() %></h3>
                </div>
                <div class="bg-orange-500/10 text-orange-400 p-3 rounded-lg">
                    <i class="fa-solid fa-fire text-xl"></i>
                </div>
            </div>
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">Harmonized FRP (Avg)</p>
                    <h3 class="text-2xl font-bold text-white mt-1">34.2 MW</h3>
                </div>
                <div class="bg-red-500/10 text-red-400 p-3 rounded-lg">
                    <i class="fa-solid fa-bolt text-xl"></i>
                </div>
            </div>
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">Historical Anomaly</p>
                    <h3 class="text-2xl font-bold text-emerald-400 mt-1">+14.2%</h3>
                </div>
                <div class="bg-emerald-500/10 text-emerald-400 p-3 rounded-lg">
                    <i class="fa-solid fa-chart-line text-xl"></i>
                </div>
            </div>
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow flex items-center justify-between">
                <div>
                    <p class="text-xs font-medium text-slate-400">Active Sensors</p>
                    <h3 class="text-2xl font-bold text-sky-400 mt-1">MODIS + VIIRS</h3>
                </div>
                <div class="bg-sky-500/10 text-sky-400 p-3 rounded-lg">
                    <i class="fa-solid fa-satellite text-xl"></i>
                </div>
            </div>
        </div>

        <!-- Map & Charts Section -->
        <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
            <!-- Google Map Container (2 cols) -->
            <div class="lg:col-span-2 bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg flex flex-col">
                <div class="flex justify-between items-center mb-3">
                    <h2 class="text-base font-semibold text-white flex items-center">
                        <i class="fa-solid fa-map-location-dot text-orange-500 mr-2"></i> Active Fire Hotspots Map (Google Maps)
                    </h2>
                    <span class="text-xs text-slate-400">Showing filtered points</span>
                </div>
                <div id="map" class="rounded-lg border border-slate-700"></div>
                <p class="text-xs text-slate-400 mt-2">Click any marker to inspect sensor type, Fire Radiative Power (FRP), and acquisition time.</p>
            </div>

            <!-- Analytics Chart (1 col) -->
            <div class="bg-slate-800 p-4 rounded-xl border border-slate-700 shadow-lg flex flex-col">
                <h2 class="text-base font-semibold text-white flex items-center mb-3">
                    <i class="fa-solid fa-chart-bar text-orange-500 mr-2"></i> Monthly Hotspot Trends
                </h2>
                <div class="flex-1 flex items-center justify-center">
                    <canvas id="trendChart"></canvas>
                </div>
            </div>
        </div>

        <!-- Burning Activity Calendar Heatmap -->
        <div class="bg-slate-800 p-6 rounded-xl border border-slate-700 shadow-lg">
            <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-4">
                <div>
                    <h2 class="text-lg font-bold text-white flex items-center">
                        <i class="fa-solid fa-calendar-days text-orange-500 mr-2"></i> Burning Activity Calendar Heatmap (2018 - 2026)
                    </h2>
                    <p class="text-xs text-slate-400">Color intensity reflects monthly active fire count compared to historical averages.</p>
                </div>
                <div class="flex items-center space-x-2 mt-2 md:mt-0 text-xs text-slate-400">
                    <span>Low Activity</span>
                    <span class="w-4 h-4 bg-emerald-900 rounded"></span>
                    <span class="w-4 h-4 bg-yellow-600 rounded"></span>
                    <span class="w-4 h-4 bg-orange-600 rounded"></span>
                    <span class="w-4 h-4 bg-red-600 rounded"></span>
                    <span>Extreme</span>
                </div>
            </div>

            <div class="overflow-x-auto">
                <table class="w-full text-center border-collapse">
                    <thead>
                        <tr class="border-b border-slate-700 text-xs text-slate-400">
                            <th class="py-2 px-3 text-left">Year</th>
                            <th class="py-2">Jan</th>
                            <th class="py-2">Feb</th>
                            <th class="py-2">Mar</th>
                            <th class="py-2">Apr</th>
                            <th class="py-2">May</th>
                            <th class="py-2">Jun</th>
                            <th class="py-2">Jul</th>
                            <th class="py-2">Aug</th>
                            <th class="py-2">Sep</th>
                            <th class="py-2">Oct</th>
                            <th class="py-2">Nov</th>
                            <th class="py-2">Dec</th>
                        </tr>
                    </thead>
                    <tbody class="text-xs">
                        <% if (calendarData && calendarData.length > 0) { %>
                            <% calendarData.forEach(row => { %>
                                <tr class="border-b border-slate-700/50">
                                    <td class="py-2 px-3 font-semibold text-left text-slate-300"><%= row.year %></td>
                                    <% for (let m = 1; m <= 12; m++) { 
                                        const mData = row.months[m] || { count: 0 };
                                        const count = mData.count;
                                        // Color mapping based on count
                                        let bgClass = 'bg-slate-900 text-slate-500';
                                        if (count > 150) bgClass = 'bg-red-600 text-white font-bold';
                                        else if (count > 100) bgClass = 'bg-orange-600 text-white font-bold';
                                        else if (count > 50) bgClass = 'bg-yellow-600 text-white';
                                        else if (count > 10) bgClass = 'bg-emerald-900 text-emerald-300';
                                    %>
                                        <td class="p-1">
                                            <div class="heatmap-cell py-2 rounded <%= bgClass %> cursor-pointer" 
                                                 title="Year: <%= row.year %>, Month: <%= m %>, Hotspots: <%= count %>, Anomaly: <%= mData.anomaly_percentage %>%">
                                                <%= count %>
                                            </div>
                                        </td>
                                    <% } %>
                                </tr>
                            <% }) %>
                        <% } %>
                    </tbody>
                </table>
            </div>
        </div>

    </main>

    <!-- Footer -->
    <footer class="bg-slate-800 border-t border-slate-700 mt-12 py-6 text-center text-xs text-slate-400">
        <p>TerraVision Harmonized Fire Intelligence Platform | Powered by MODIS, VIIRS & NASA FIRMS Harmonization Engine</p>
    </footer>

    <!-- Google Maps Initialization with Hotspots Data -->
    <script>
        const hotspots = <%- JSON.stringify(hotspots) %>;

        function initMap() {
            // Default center around Western US / California
            const defaultCenter = { lat: 38.5, lng: -115.0 };
            const map = new google.maps.Map(document.getElementById("map"), {
                zoom: 5,
                center: defaultCenter,
                styles: [
                    { elementType: "geometry", stylers: [{ color: "#242f3e" }] },
                    { elementType: "labels.text.stroke", stylers: [{ color: "#242f3e" }] },
                    { elementType: "labels.text.fill", stylers: [{ color: "#746855" }] },
                    {
                        featureType: "administrative.locality",
                        elementType: "labels.text.fill",
                        styler: [{ color: "#d59563" }]
                    },
                    {
                        featureType: "poi",
                        elementType: "labels.text.fill",
                        styler: [{ color: "#d59563" }]
                    },
                    {
                        featureType: "poi.park",
                        elementType: "geometry",
                        styler: [{ color: "#263c3f" }]
                    },
                    {
                        featureType: "road",
                        elementType: "geometry",
                        styler: [{ color: "#38414e" }]
                    },
                    {
                        featureType: "water",
                        elementType: "geometry",
                        styler: [{ color: "#17263c" }]
                    }
                ]
            });

            const infowindow = new google.maps.InfoWindow();

            hotspots.forEach(h => {
                const markerColor = h.sensor === 'VIIRS' ? '#f97316' : '#38bdf8'; // Orange for VIIRS, Sky for MODIS
                
                const marker = new google.maps.Marker({
                    position: { lat: h.latitude, lng: h.longitude },
                    map: map,
                    title: `${h.sensor} Hotspot - FRP: ${h.frp} MW`,
                    icon: {
                        path: google.maps.SymbolPath.CIRCLE,
                        scale: h.sensor === 'VIIRS' ? 5 : 6,
                        fillColor: markerColor,
                        fillOpacity: 0.85,
                        strokeColor: "#ffffff",
                        strokeWeight: 1
                    }
                });

                marker.addListener("click", () => {
                    const content = `
                        <div style="color: #0f172a; font-family: sans-serif; padding: 4px;">
                            <h3 style="font-weight: bold; font-size: 14px; margin-bottom: 4px; color: #c2410c;">
                                <i class="fa-solid fa-fire"></i> ${h.sensor} (${h.satellite})
                            </h3>
                            <p style="font-size: 12px; margin: 2px 0;"><b>Date:</b> ${h.acq_date} (${h.acq_time})</p>
                            <p style="font-size: 12px; margin: 2px 0;"><b>Coordinates:</b> ${h.latitude}, ${h.longitude}</p>
                            <p style="font-size: 12px; margin: 2px 0;"><b>Fire Radiative Power (FRP):</b> ${h.frp} MW</p>
                            <p style="font-size: 12px; margin: 2px 0;"><b>Confidence:</b> ${h.confidence}%</p>
                            <p style="font-size: 12px; margin: 2px 0;"><b>Brightness:</b> ${h.brightness} K</p>
                        </div>
                    `;
                    infowindow.setContent(content);
                    infowindow.open(map, marker);
                });
            });
        }

        // Initialize Chart.js Trend
        const ctx = document.getElementById('trendChart').getContext('2d');
        new Chart(ctx, {
            type: 'line',
            data: {
                labels: ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'],
                datasets: [{
                    label: '2025-2026 Hotspots',
                    data: [12, 19, 35, 88, 142, 210, 315, 290, 180, 95, 40, 15],
                    borderColor: '#f97316',
                    backgroundColor: 'rgba(249, 115, 22, 0.1)',
                    fill: true,
                    tension: 0.3
                }, {
                    label: 'Historical Median',
                    data: [10, 15, 30, 75, 120, 190, 280, 260, 160, 80, 35, 12],
                    borderColor: '#94a3b8',
                    borderDash: [5, 5],
                    fill: false,
                    tension: 0.3
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    legend: { labels: { color: '#cbd5e1', font: { size: 11 } } }
                },
                scales: {
                    x: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } },
                    y: { ticks: { color: '#94a3b8' }, grid: { color: '#334155' } }
                }
            }
        });
    </script>
    <!-- Google Maps API with callback -->
    <script async defer src="https://maps.googleapis.com/maps/api/js?key=<%= googleMapsApiKey %>&callback=initMap"></script>
</body>
</html>
